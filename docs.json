              {
                "group": "Базы данных",
                "icon": "database",
                "pages": [
                  "create-app",
                  {
                    "group": "Управление БД",
                    "icon": "server",
                    "pages": [
                      "control-db",
                      "console-and-control-server-db",
                      "backup-bd",
                      {
                        "group": "Настройки",
                        "icon": "gear-complex",
                        "expanded": true,
                        "pages": [
                          "plan-db",
                          "delete-or-renistall-db"
                        ]
                      },
                      "create-useranddb"
                    ]
                  }
                ]
              },
              {
                "group": "Аккаунт",
                "icon": "user",
                "expanded": true,
